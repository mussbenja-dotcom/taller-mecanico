# ===============================================
# CONFIGURACIÓN — copiá este archivo como .env
# (en Git Bash:  cp .env.ejemplo .env  y editalo)
# ===============================================

# --- Login del dueño ---
# Cambiá estos valores por los que quieras.
ADMIN_USUARIO=admin
ADMIN_PASSWORD=taller2025

# Empleado (ve solo Órdenes y Diagnóstico IA, sin precios ni métricas)
EMPLEADO_USUARIO=empleado
EMPLEADO_PASSWORD=taller123

# --- IA (Google Gemini) ---
# La clave es GRATIS. Sacala en: https://aistudio.google.com/apikey
# Iniciás sesión con tu cuenta de Google, clic en "Create API key",
# copiás la clave y la pegás acá abajo.
GEMINI_API_KEY=

# --- Base de datos (opcional) ---
# Sin esto, usa SQLite local. Para Neon:
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx-pooler.../db?sslmode=require
